{
  "name": "gummy-ui",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "node scripts/dedupe-esbuild.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "bun run --cwd packages/ui build && bun run --cwd apps/api build && bun run --cwd apps/example build && bun run --cwd apps/studio build",
    "studio": "bun run --cwd apps/studio dev",
    "example": "bun run --cwd apps/example dev",
    "api": "bun run --cwd apps/api dev",
    "tauri:dev": "bun run --cwd apps/studio tauri:dev",
    "tauri:build": "bun run --cwd apps/studio tauri:build"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "overrides": {
    "esbuild": "0.27.7"
  }
}
