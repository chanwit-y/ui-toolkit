# The HTTP base URL the engine calls (overrides the project's env.API_URL). Empty = same origin (the Vite proxy in dev).
VITE_API_URL=
# Which gummy/projects/<key>/ (or <key>.json) to render when there are several (default book-shop).
# VITE_GUMMY_PROJECT=book-shop

# Azure SSO (the project's `auth`). Without a tenant, sign a mock staff account in (api/README.md → Staff):
# chanwit_y@ (manager), pimchanok_s@ (clerk), nadia_s@ (former staff → the denied screen), all @gummay.co.th.
VITE_AUTH_MOCK_EMAIL=chanwit_y@gummay.co.th
# With a tenant, unset the mock and fill these (names from the studio's Sign-in entry):
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=
VITE_AZURE_REDIRECT_URL=
VITE_AZURE_API_SCOPE=
