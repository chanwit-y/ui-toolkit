{
  "containers": [
    {
      "id": "country-page",
      "name": "Country",
      "isArray": false,
      "gap": "4",
      "justifyItems": "stretch",
      "alignItems": "start",
      "justifyContent": "start",
      "alignContent": "start",
      "gridAutoFlow": "row",
      "bins": [
        {
          "sm": "12",
          "md": "6",
          "lg": "5",
          "xl": "4",
          "type": "card",
          "element": {
            "name": "countryCard",
            "variant": "outlined",
            "header": {
              "title": "Loading…",
              "titleValue": {
                "type": "state",
                "key": "country",
                "path": "name"
              },
              "subheader": "—",
              "subheaderValue": {
                "type": "state",
                "key": "country",
                "path": "code"
              },
              "avatar": {
                "size": "md",
                "fallback": "?",
                "srcValue": {
                  "type": "state",
                  "key": "country",
                  "path": "avatar"
                },
                "fallbackValue": {
                  "type": "state",
                  "key": "country",
                  "path": "code"
                }
              }
            },
            "media": {
              "height": 160,
              "alt": "Flag",
              "srcValue": {
                "type": "state",
                "key": "country",
                "path": "image"
              }
            },
            "actions": [
              {
                "label": "Reload",
                "icon": "refresh",
                "variant": "text",
                "actions": [
                  "ReloadDataTable"
                ],
                "reloadDataTable": "country"
              }
            ],
            "actionsAlign": "end"
          }
        },
        {
          "sm": "12",
          "md": "6",
          "lg": "7",
          "xl": "8",
          "type": "container",
          "container": {
            "id": "country-facts",
            "name": "CountryFacts",
            "isArray": false,
            "gap": "3",
            "justifyItems": "stretch",
            "alignItems": "start",
            "justifyContent": "start",
            "alignContent": "start",
            "gridAutoFlow": "row",
            "bins": [
              {
                "sm": "12",
                "md": "12",
                "lg": "12",
                "xl": "12",
                "type": "typography",
                "element": {
                  "text": "Last update",
                  "variant": "subtitle1",
                  "weight": "medium"
                }
              },
              {
                "sm": "12",
                "md": "12",
                "lg": "12",
                "xl": "12",
                "type": "typography",
                "element": {
                  "text": "—",
                  "variant": "body2",
                  "color": "gray",
                  "value": {
                    "type": "state",
                    "key": "country",
                    "path": "updated_by_name"
                  }
                }
              },
              {
                "sm": "12",
                "md": "12",
                "lg": "12",
                "xl": "12",
                "type": "custom",
                "element": {
                  "component": "StatBadge",
                  "props": {
                    "label": "Code",
                    "tone": "accent"
                  },
                  "value": {
                    "type": "state",
                    "key": "country",
                    "path": "code"
                  }
                }
              },
              {
                "sm": "6",
                "md": "4",
                "lg": "3",
                "xl": "3",
                "type": "button",
                "justifySelf": "start",
                "element": {
                  "label": "Back to list",
                  "variant": "text",
                  "actions": [
                    "Navigate"
                  ],
                  "navigate": {
                    "page": "countries"
                  }
                }
              },
              {
                "sm": "6",
                "md": "4",
                "lg": "3",
                "xl": "3",
                "type": "button",
                "justifySelf": "start",
                "element": {
                  "label": "Say hello",
                  "icon": "info",
                  "variant": "outlined",
                  "actions": [
                    "fn:greet"
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "loads": [
    {
      "key": "country",
      "loading": "skeleton",
      "errorMessage": "Country not found.",
      "api": {
        "name": "countryDetail",
        "paths": [
          "data"
        ],
        "params": {
          "id": {
            "type": "url",
            "key": "id"
          }
        }
      }
    }
  ]
}
