  "api": {
    "listGenres": {
      "url": "/api/genres",
      "description": "Every genre, by name",
      "methods": "GET",
      "response": "genreListRes",
      "withOptions": false
    },
    "listAuthors": {
      "url": "/api/authors",
      "description": "Authors (optionally of one genre, or matching a name)",
      "methods": "GET",
      "response": "authorListRes",
      "query": "authorQuery",
      "withOptions": false
    },
    "genreAuthors": {
      "url": "/api/genres/:genre/authors",
      "description": "Authors with a book in one genre (the dependent filter)",
      "methods": "GET",
      "response": "authorListRes",
      "parameter": "genreParam",
      "withOptions": false
    },
    "getAuthor": {
      "url": "/api/authors/:id",
      "description": "One author with their books",
      "methods": "GET",
      "response": "authorDetailRes",
      "parameter": "idParam",
      "withOptions": false
    },
    "listAuthorLinks": {
      "url": "/api/authors/:authorId/links",
      "description": "An author's links",
      "methods": "GET",
      "response": "linkListRes",
      "parameter": "authorIdParam",
      "withOptions": false
    },
    "createAuthorLink": {
      "url": "/api/authors/:authorId/links",
      "description": "Add a link to an author",
      "methods": "POST",
      "response": "linkRes",
      "parameter": "authorIdParam",
      "body": "linkBody",
      "withOptions": false
    },
    "updateAuthorLink": {
      "url": "/api/authors/:authorId/links/:id",
      "description": "Change one link",
      "methods": "PATCH",
      "response": "linkRes",
      "parameter": "authorItemParam",
      "body": "linkBody",
      "withOptions": false
    },
    "deleteAuthorLink": {
      "url": "/api/authors/:authorId/links/:id",
      "description": "Remove one link",
      "methods": "DELETE",
      "response": "deletedRes",
      "parameter": "authorItemParam",
      "withOptions": false
    },
    "listBooks": {
      "url": "/api/books",
      "description": "A page of books (search, genre, author, stock, sort)",
      "methods": "GET",
      "response": "bookListRes",
      "query": "bookPageQuery",
      "withOptions": false
    },
    "getBook": {
      "url": "/api/books/:id",
      "description": "One book",
      "methods": "GET",
      "response": "bookRes",
      "parameter": "idParam",
      "withOptions": false
    },
    "createBook": {
      "url": "/api/books",
      "description": "Add a book",
      "methods": "POST",
      "response": "bookRes",
      "body": "bookBody",
      "withOptions": false
    },
    "updateBook": {
      "url": "/api/books/:id",
      "description": "Change a book",
      "methods": "PATCH",
      "response": "bookRes",
      "parameter": "idParam",
      "body": "bookBody",
      "withOptions": false
    },
    "deleteBook": {
      "url": "/api/books/:id/delete",
      "description": "Delete a book (a form button can only POST / PATCH)",
      "methods": "POST",
      "response": "deletedRes",
      "parameter": "idParam",
      "body": "bookBody",
      "withOptions": false
    },
    "listEditions": {
      "url": "/api/books/:bookId/editions",
      "description": "A book's editions",
      "methods": "GET",
      "response": "editionListRes",
      "parameter": "bookIdParam",
      "withOptions": false
    },
