  "pages": {
    "dashboard": {
      "path": "/",
      "title": "Dashboard",
      "src": "pages/dashboard.json"
    },
    "catalogue": {
      "path": "/catalogue",
      "title": "Catalogue",
      "src": "pages/catalogue.json"
    },
    "books": {
      "path": "/books",
      "title": "Books",
      "src": "pages/books.json"
    },
    "bookDetail": {
      "path": "/books/:id",
      "title": {
        "type": "state",
        "key": "book",
        "path": "title"
      },
      "parent": "books",
      "src": "pages/bookDetail.json"
    },
    "authors": {
      "path": "/authors",
      "title": "Authors",
      "src": "pages/authors.json"
    },
    "authorDetail": {
      "path": "/authors/:id",
      "title": {
        "type": "state",
        "key": "author",
        "path": "name"
      },
      "parent": "authors",
      "src": "pages/authorDetail.json"
    },
    "orders": {
      "path": "/orders",
      "title": "Orders",
      "src": "pages/orders.json"
    },
    "orderDetail": {
      "path": "/orders/:id",
      "title": {
        "type": "state",
        "key": "order",
        "path": "number"
      },
      "parent": "orders",
      "src": "pages/orderDetail.json"
    },
    "customers": {
      "path": "/customers",
      "title": "Customers",
      "src": "pages/customers.json"
    },
    "customerDetail": {
      "path": "/customers/:id",
      "title": {
        "type": "state",
        "key": "customer",
        "path": "name"
      },
      "parent": "customers",
      "src": "pages/customerDetail.json"
    },
    "settings": {
      "path": "/settings",
      "title": "Settings",
      "src": "pages/settings.json"
    }
