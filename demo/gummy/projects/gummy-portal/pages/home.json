            "html": "<h4 style=\"margin:8px 0 12px;font-size:18px;font-weight:600;color:var(--accent-11)\">Favorite apps</h4><div style=\"display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:20px\"><a href=\"#\" style=\"display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;color:var(--gray-12)\">\n  <span style=\"display:flex;width:72px;height:72px;align-items:center;justify-content:center;border-radius:18px;background:var(--iris-3);color:var(--iris-11);font-size:26px;font-weight:700;box-shadow:0 1px 2px var(--gray-a4)\">D</span>\n  <span style=\"font-size:13px;font-weight:500\">DOA</span>\n</a><a href=\"#\" style=\"display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;color:var(--gray-12)\">\n  <span style=\"display:flex;width:72px;height:72px;align-items:center;justify-content:center;border-radius:18px;background:var(--grass-3);color:var(--grass-11);font-size:26px;font-weight:700;box-shadow:0 1px 2px var(--gray-a4)\">L</span>\n  <span style=\"font-size:13px;font-weight:500\">Leave</span>\n</a><a href=\"#\" style=\"display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;color:var(--gray-12)\">\n  <span style=\"display:flex;width:72px;height:72px;align-items:center;justify-content:center;border-radius:18px;background:var(--amber-3);color:var(--amber-11);font-size:26px;font-weight:700;box-shadow:0 1px 2px var(--gray-a4)\">E</span>\n  <span style=\"font-size:13px;font-weight:500\">Expense</span>\n</a><a href=\"#\" style=\"display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;color:var(--gray-12)\">\n  <span style=\"display:flex;width:72px;height:72px;align-items:center;justify-content:center;border-radius:18px;background:var(--cyan-3);color:var(--cyan-11);font-size:26px;font-weight:700;box-shadow:0 1px 2px var(--gray-a4)\">R</span>\n  <span style=\"font-size:13px;font-weight:500\">Room booking</span>\n</a></div>",
