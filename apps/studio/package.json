{
  "name": "@gummy-ui/studio",
  "version": "0.0.0",
  "description": "Gummy Studio — the visual builder for @gummy-ui/ui projects, as a prebuilt static app served by `gummy studio` (@gummy-ui/cli)",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./headless": "./dist/headless.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port 3300",
    "build": "bun scripts/gen-schemas.ts && tsc -b && vite build && bun scripts/build-headless.ts",
    "build:headless": "bun scripts/gen-schemas.ts && bun scripts/build-headless.ts",
    "schemas": "bun scripts/gen-schemas.ts",
    "test": "bun test",
    "lint": "eslint .",
    "preview": "vite preview --port 3300"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@gummy-ui/ui": "workspace:*",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@radix-ui/themes": "^3.2.1",
    "@sinclair/typebox": "^0.34.0",
    "dayjs": "^1.11.5",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
