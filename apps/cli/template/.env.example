# The HTTP base URL the engine calls (overrides the project's env.API_URL). Empty = same origin (the Vite proxy in dev).
VITE_API_URL=
# Which gummy/projects/<key>.json to render when there are several.
# VITE_GUMMY_PROJECT=__KEY__

# Azure SSO, when the project picked a Sign-in entry in the studio. Without a tenant, sign a mock account in:
# VITE_AUTH_MOCK_EMAIL=you@example.com
# With a tenant, unset the mock and fill these (names from the entry):
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=
VITE_AZURE_REDIRECT_URL=
VITE_AZURE_API_SCOPE=
