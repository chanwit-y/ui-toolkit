{
  "schemaVersion": 1,
  "name": "__NAME__",
  "description": "Starter project written by `gummy init`. Open the studio (`npm run studio`) to design it; every save rewrites this file.",
  "env": {
    "API_URL": ""
  },
  "model": {},
  "api": {},
  "pages": {
    "home": {
      "path": "/",
      "title": "Home",
      "breadcrumb": false,
      "containers": [
        {
          "id": "home-page",
          "name": "Home",
          "isArray": false,
          "gap": "4",
          "justifyItems": "stretch",
          "alignItems": "start",
          "justifyContent": "start",
          "alignContent": "start",
          "gridAutoFlow": "row",
          "bins": [
            {
              "sm": "12",
              "md": "12",
              "lg": "12",
              "xl": "12",
              "type": "typography",
              "element": {
                "text": "Welcome to __NAME__",
                "variant": "h4",
                "weight": "medium"
              }
            },
            {
              "sm": "12",
              "md": "12",
              "lg": "12",
              "xl": "12",
              "type": "typography",
              "element": {
                "text": "This page is gummy/projects/__KEY__.json, rendered by <GummyApp>. Run `npm run studio` to design it; the file is rewritten on every save and Vite reloads.",
                "variant": "body2",
                "color": "gray"
              }
            }
          ]
        }
      ]
    }
  },
  "menu": [
    {
      "label": "Home",
      "icon": "home",
      "navigate": {
        "page": "home"
      }
    }
  ],
  "shell": {
    "navigation": "sidebar",
    "breadcrumbs": true,
    "appBar": {
      "title": "__NAME__"
    }
  },
  "theme": {
    "theme": {
      "accentColor": "teal",
      "radius": "medium"
    },
    "components": {
      "button": {
        "color": "teal"
      }
    }
  },
  "globalLoads": [],
  "customActions": [
    "greet"
  ],
  "customComponents": [
    {
      "name": "StatBadge",
      "description": "A labelled pill showing the bound value.",
      "props": [
        {
          "key": "label",
          "kind": "text",
          "label": "Label"
        },
        {
          "key": "tone",
          "kind": "select",
          "label": "Tone",
          "options": [
            "accent",
            "green",
            "gray"
          ],
          "defaultValue": "gray"
        }
      ]
    }
  ]
}
